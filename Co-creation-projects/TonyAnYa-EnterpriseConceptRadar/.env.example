# =========================================
# EnterpriseConceptRadar 环境变量示例
# =========================================

# 运行模式
APP_ENV=development
APP_MODE=demo

# HelloAgents / LLM
LLM_PROVIDER=deepseek
LLM_API_KEY=replace_with_your_api_key
LLM_MODEL_ID=replace_with_your_model_id
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=60

# 搜索配置
SEARCH_BACKEND=serpapi
SERPAPI_API_KEY=replace_with_your_serpapi_key
SEARCH_MAX_RESULTS=5

# 项目配置
DATABASE_PATH=data/runtime/concept_radar.sqlite3
OUTPUT_LANGUAGE=zh-CN
TIMEZONE=Asia/Shanghai

# 在线抓取开关
ENABLE_LIVE_NEA=false
ENABLE_LIVE_NDRC=false
ENABLE_TRENDRADAR=false